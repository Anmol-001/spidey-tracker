{
  "name": "spidey-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade sighting and incident tracker monorepo",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "type-check": "npm run type-check --workspace=server && npm run type-check --workspace=client",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "lint:fix": "npm run lint:fix --workspace=server && npm run lint:fix --workspace=client",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "incident-tracker",
    "spidey-tracker",
    "monorepo",
    "mern",
    "typescript",
    "clean-architecture"
  ],
  "author": "Spidey Tracker Engineering Team",
  "license": "MIT",
  "dependencies": {
    "mongodb": "^7.5.0"
  }
}
