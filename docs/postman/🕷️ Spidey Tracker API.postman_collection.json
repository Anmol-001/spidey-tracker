    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"User registered successfully\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data).to.have.property(\"user\");",
                  "    pm.expect(response.data.user).to.have.property(\"id\");",
                  "    pm.expect(response.data.user).to.have.property(\"username\");",
                  "    pm.expect(response.data.user).to.have.property(\"email\");",
                  "    pm.expect(response.data.user).to.not.have.property(\"passwordHash\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"PeterParker\",\n  \"email\": \"peter.parker@dailybugle.com\",\n  \"password\": \"Spider@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "register"]
            },
            "description": "Registers a new user account with hashed password persistence."
          },
          "response": []
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "if (response.success && response.data && response.data.accessToken) {",
                  "    pm.environment.set(\"accessToken\", response.data.accessToken);",
                  "    console.log(\"accessToken saved to Postman environment successfully.\");",
                  "} else {",
                  "    console.warn(\"No accessToken found in response.\");",
                  "}",
                  "",
                  "pm.test(\"Login returned access token\", function () {",
                  "    pm.expect(response.data).to.have.property(\"accessToken\");",
                  "    pm.expect(response.data).to.have.property(\"user\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"peter.parker@dailybugle.com\",\n  \"password\": \"Spider@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "login"]
            },
            "description": "Authenticates user credentials, generates JWT access token, and automatically stores accessToken in Postman environment."
          },
          "response": []
        },
        {
          "name": "GET /auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Identity verified\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data).to.have.property(\"user\");",
                  "    pm.expect(response.data.user).to.have.property(\"id\");",
                  "    pm.expect(response.data.user).to.have.property(\"email\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "auth", "me"]
            },
            "description": "Protected probe endpoint verifying JWT authentication middleware."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "GET /users/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Sanitized user profile returned\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data).to.have.property(\"id\");",
                  "    pm.expect(response.data).to.have.property(\"username\");",
                  "    pm.expect(response.data).to.have.property(\"email\");",
                  "    pm.expect(response.data).to.have.property(\"role\");",
                  "    pm.expect(response.data).to.have.property(\"isActive\");",
                  "    pm.expect(response.data).to.not.have.property(\"passwordHash\");",
                  "    pm.expect(response.data).to.not.have.property(\"__v\");",
                  "    pm.expect(response.data).to.not.have.property(\"_id\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "users", "me"]
            },
            "description": "Protected endpoint retrieving the full sanitized profile for the authenticated user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Incident",
      "item": [
        {
          "name": "POST /incidents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Incident created with correct defaults\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data).to.have.property(\"id\");",
                  "    pm.expect(response.data.title).to.eql(\"Bank robbery in progress\");",
                  "    pm.expect(response.data.category).to.eql(\"crime\");",
                  "    pm.expect(response.data.status).to.eql(\"open\");",
                  "    pm.expect(response.data.severity).to.eql(\"medium\");",
                  "    pm.expect(response.data.assignedTo).to.be.null;",
                  "    pm.expect(response.data).to.have.property(\"createdBy\");",
                  "    pm.expect(response.data.latitude).to.eql(40.7128);",
                  "    pm.expect(response.data.longitude).to.eql(-74.006);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bank robbery in progress\",\n  \"description\": \"Armed robbery reported at Financial District branch.\",\n  \"category\": \"crime\",\n  \"latitude\": 40.7128,\n  \"longitude\": -74.006,\n  \"address\": \"123 Wall St, New York, NY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/incidents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "incidents"]
            },
            "description": "Protected endpoint to report a new incident. Assigns backend defaults (status: open, severity: medium, assignedTo: null, createdBy: user.id)."
          },
          "response": []
        }
      ]
    }
